# Copy to `.env.development` to point local development at a local API.
#
# Next.js loads `.env.development` for `next dev` only, and it takes precedence
# over `.env` — so this overrides the deployed API URL in development without
# touching the production value.
#
# Without this file, `npm run dev` talks to the deployed API, which will not have
# any endpoint you have added locally but not yet deployed.
#
# 3005 is the API's default port (src/main.ts), and /api is its global prefix.
NEXT_PUBLIC_API_URL="http://localhost:3005/api"
